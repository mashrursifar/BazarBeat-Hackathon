{
  "name": "@bazarbeat/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run --fileParallelism=false",
    "seed": "tsx src/seed/seed-crops.ts",
    "seed:dev-listings": "tsx src/seed/seed-dev-listings.ts",
    "seed:demo": "tsx src/seed/seed-demo.ts",
    "demo:reset": "tsx src/seed/seed-demo.ts --reset",
    "demo:spawn-auctions": "tsx src/seed/demo-spawn-auctions.ts",
    "dev:bid": "tsx scripts/dev-bid.ts",
    "resolve-dispute": "tsx scripts/resolve-dispute.ts",
    "preflight": "tsx scripts/preflight.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1172.0",
    "@bazarbeat/shared": "*",
    "@types/compression": "^1.8.1",
    "bcrypt": "^6.0.0",
    "compression": "^1.8.2",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^16.6.1",
    "express": "^5.1.0",
    "express-rate-limit": "^8.7.3",
    "helmet": "^8.3.0",
    "mongoose": "^8.19.2",
    "multer": "^2.5.0",
    "pino": "^9.14.0",
    "sharp": "^0.35.5",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@types/bcrypt": "^6.0.0",
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.5",
    "@types/multer": "^2.3.0",
    "@types/sharp": "^0.31.1",
    "@types/supertest": "^6.0.3",
    "mongodb-memory-server": "^11.3.0",
    "supertest": "^7.1.4",
    "tsx": "^4.20.6"
  }
}
