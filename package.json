{
  "name": "bazarbeat",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/api",
    "apps/web",
    "packages/shared"
  ],
  "scripts": {
    "dev": "concurrently -k -n api,web -c blue,green \"npm run dev -w @bazarbeat/api\" \"npm run dev -w @bazarbeat/web\"",
    "build": "npm run build -w @bazarbeat/shared && npm run build -w @bazarbeat/api && npm run build -w @bazarbeat/web",
    "start": "npm run start -w @bazarbeat/api",
    "typecheck": "npm run typecheck -w @bazarbeat/shared && npm run typecheck -w @bazarbeat/api && npm run typecheck -w @bazarbeat/web && tsc -p ai-eval/tsconfig.json --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "npm run test -w @bazarbeat/shared && npm run test -w @bazarbeat/api && npm run test -w @bazarbeat/web && vitest run ai-eval/src",
    "test:api": "npm run test -w @bazarbeat/api",
    "test:web": "npm run test -w @bazarbeat/web",
    "test:eval": "vitest run ai-eval/src",
    "test:e2e": "playwright test",
    "test:smoke": "playwright test e2e/smoke-deployment.spec.ts",
    "test:smoke:ai": "playwright test e2e/smoke-live-ai.spec.ts",
    "curate:demo-photos": "tsx ai-eval/src/curate-demo-photos.ts",
    "eval:dataset": "tsx ai-eval/src/generate-dataset.ts",
    "eval:harness": "tsx ai-eval/src/cli.ts",
    "eval:mock": "tsx ai-eval/src/cli.ts --provider mock --split dev",
    "eval:majority": "tsx ai-eval/src/cli.ts --provider majority --split dev",
    "eval:gemini": "tsx ai-eval/src/cli.ts --provider gemini --split dev",
    "eval:gemini:test": "tsx ai-eval/src/cli.ts --provider gemini --split test",
    "eval:price": "tsx ai-eval/src/price-eval.ts",
    "seed": "npm run seed -w @bazarbeat/api",
    "seed:dev-listings": "npm run seed:dev-listings -w @bazarbeat/api",
    "seed:demo": "npm run seed:demo -w @bazarbeat/api",
    "demo:reset": "npm run demo:reset -w @bazarbeat/api",
    "demo:spawn-auctions": "npm run demo:spawn-auctions -w @bazarbeat/api",
    "dev:bid": "npm run dev:bid -w @bazarbeat/api --",
    "resolve-dispute": "npm run resolve-dispute -w @bazarbeat/api --",
    "preflight": "npm run preflight -w @bazarbeat/api --"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.56.1",
    "@types/node": "^24.10.0",
    "caniuse-lite": "^1.0.30001819",
    "concurrently": "^9.2.1",
    "eslint": "^10.14.0",
    "jsdom": "^26.1.0",
    "prettier": "^3.6.2",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.46.2",
    "vitest": "^3.2.4"
  }
}
