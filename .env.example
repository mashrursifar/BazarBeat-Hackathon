NODE_ENV=development
PORT=4000
MONGODB_URI=mongodb://127.0.0.1:27017/BazarBeat
JWT_ACCESS_SECRET=replace-with-a-local-development-secret
JWT_REFRESH_SECRET=replace-with-another-local-development-secret
COOKIE_DOMAIN=
CORS_ORIGINS=http://localhost:5173
# AI and Storage
AI_PROVIDER=mock
AI_SERVICE_URL=http://localhost:8000
AI_SERVICE_KEY=local-mock-key
STORAGE_PROVIDER=local
UPLOAD_DIR=./uploads
# S3-Compatible Cloud Storage (Cloudflare R2, AWS S3, Backblaze B2, MinIO)
# Set STORAGE_PROVIDER=cloud and provide S3 credentials below:
# S3_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
# S3_BUCKET=bazarbeat-uploads
# S3_ACCESS_KEY_ID=your_access_key_id
# S3_SECRET_ACCESS_KEY=your_secret_access_key
# S3_REGION=auto
# S3_PUBLIC_URL=https://pub-xxxxxxxx.r2.dev
# S3_FORCE_PATH_STYLE=false
# Legacy/Alternative Cloudinary Storage fallback
# CLOUDINARY_URL=cloudinary://api_key:api_secret@cloud_name
# CLOUDINARY_CLOUD_NAME=your_cloud_name
# CLOUDINARY_API_KEY=your_api_key
# CLOUDINARY_API_SECRET=your_api_secret

# Demo & Auction/Order Timing Modes
# Set DEMO_MODE=true for rapid auction expirations (e.g. 1-2 min durations, 15s anti-sniping)
# and scaled order timers (1 min auto-cancel for unconfirmed orders; 2 min auto-complete for delivered orders)
DEMO_MODE=false
# Guard for demo seed scripts (seed:demo, demo:reset, demo:spawn-auctions).
# Refuses to run unless target database is explicitly permitted:
ALLOW_DEMO_SEED=false
PLATFORM_FEE_BPS=200
VITE_API_URL=/api/v1
SEED_HISTORY=true

# Production Hardening & Reverse Proxy (Task 9.1)
# TRUST_PROXY: set to 'true', '1', or hop count/IP behind host reverse proxies (e.g. Render, Railway, Fly, Nginx)
TRUST_PROXY=false
# SERVE_WEB: when true, Express serves the built web SPA from same origin with SPA fallback
SERVE_WEB=false
# WEB_DIST_PATH: optional custom path to built web assets; defaults to apps/web/dist
# WEB_DIST_PATH=./apps/web/dist
# RATE_LIMIT_AUTH_PER_MIN: rate limit for login/registration/refresh per minute per IP (default 10, relax for demo venues)
RATE_LIMIT_AUTH_PER_MIN=10
# GIT_SHA: commit SHA or release tag reported in /api/v1/health?deep=true
GIT_SHA=dev

# Development & Demo Credentials
# Used by dev bidding CLI, demo testing, and seed fixtures:
DEV_FARMER_PHONE=01700000001
DEV_FARMER_PASSWORD=farmerpassword123
DEV_BUYER_PHONE=01712345678
DEV_BUYER_PASSWORD=buyerpassword123
