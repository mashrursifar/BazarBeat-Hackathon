NODE_ENV=development
PORT=4000
MONGODB_URI=mongodb://127.0.0.1:27017/BazarBeat
JWT_ACCESS_SECRET=replace-with-a-local-development-secret
JWT_REFRESH_SECRET=replace-with-another-local-development-secret
COOKIE_DOMAIN=
CORS_ORIGINS=http://localhost:5173
# AI and Storage
AI_PROVIDER=mock
AI_SERVICE_URL=http://localhost:8000
AI_SERVICE_KEY=local-mock-key
STORAGE_PROVIDER=local
UPLOAD_DIR=./uploads

# Demo & Auction Timing Modes
# Set DEMO_MODE=true for rapid auction expirations (e.g. 1-2 min durations, 15s anti-sniping)
DEMO_MODE=false
PLATFORM_FEE_BPS=200
VITE_API_URL=/api/v1

# Development Bidding CLI Credentials
# Used by `npm run dev:bid -- <listingId> <amountInPoisha>`
DEV_BUYER_PHONE=01712345678
DEV_BUYER_PASSWORD=buyerpassword123
