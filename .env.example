NODE_ENV=development
PORT=4000
MONGODB_URI=mongodb://127.0.0.1:27017/BazarBeat
JWT_ACCESS_SECRET=replace-with-a-local-development-secret
JWT_REFRESH_SECRET=replace-with-another-local-development-secret
COOKIE_DOMAIN=
CORS_ORIGINS=http://localhost:5173
# AI and Storage
AI_PROVIDER=mock
AI_SERVICE_URL=http://localhost:8000
AI_SERVICE_KEY=local-mock-key
STORAGE_PROVIDER=local
UPLOAD_DIR=./uploads

# Demo & Auction/Order Timing Modes
# Set DEMO_MODE=true for rapid auction expirations (e.g. 1-2 min durations, 15s anti-sniping)
# and scaled order timers (1 min auto-cancel for unconfirmed orders; 2 min auto-complete for delivered orders)
DEMO_MODE=false
PLATFORM_FEE_BPS=200
VITE_API_URL=/api/v1
SEED_HISTORY=true

# Development & Demo Credentials
# Used by dev bidding CLI, demo testing, and seed fixtures:
DEV_FARMER_PHONE=01700000001
DEV_FARMER_PASSWORD=farmerpassword123
DEV_BUYER_PHONE=01712345678
DEV_BUYER_PASSWORD=buyerpassword123
